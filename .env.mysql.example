# Optional multi-instance storage configuration for the Go gateway.
# Replace credentials and URL-encode special characters in the password.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
SILENCER_STORAGE_MODE=mysql
# Set unique passwords before starting docker-compose.mysql.yml.
# Override the DSN only when using an externally managed MySQL server.
# SILENCER_MYSQL_DSN=silencer:password@tcp(mysql:3306)/silencer?parseTime=true
# Maximum open MySQL connections (default 32); idle connections default to min(8, pool size).
SILENCER_MYSQL_POOL_SIZE=32
# Optional idle connection limit. It is capped at SILENCER_MYSQL_POOL_SIZE.
SILENCER_MYSQL_MAX_IDLE_CONNS=8
